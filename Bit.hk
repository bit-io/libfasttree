[package]
-> name        => libfasttree
-> version     => 0.4.0
-> description => FastTree — content-addressable, block-oriented następca OSTree (H#, stabilne C ABI ft_*)
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[lib]
-> output => hlib

[commands]
-> build-lib
--> run => scripts/build-lib.sh --release
--> description => Zbuduj CLI (build/fasttree) oraz libfasttree.so / .a
-> test-all
--> run => scripts/run-tests.sh
--> description => Uruchom wszystkie testy jednostkowe H# (src/tests)
-> fsck
--> run => build/fasttree fsck
--> description => Zweryfikuj integralność store i manifestów w $FASTTREE_ROOT
