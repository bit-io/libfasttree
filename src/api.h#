;; ── manifest.toml obrazu ────────────────────────────────────────────────────

fn kv(f: [string], key: string, dflt: string) -> string is
    let mut i: int = 0
    while i < f.len() is
        let p: [string] = text::split_once(f[i], "=")
        if p.len() == 2 && p[0] == key is return p[1] end
        i += 1
    end
    return dflt
end

;; Zapisuje manifest.toml systemu bazowego. `fields` = lista "klucz=wartość":
;;   name version base_release arch channel tag created   (wymagane: name version tag)
;;   desktop.environment=…  deployment.base=…             ("sekcja.klucz=wartość" = dodatkowe pola)
;; Walidacja `lmanifest::validate_manifest` (m.in. init.service_manager == zenitd). "" albo błąd.
pub fn os_manifest_write(path: string, fields: [string]) -> string is
    let gen: int = text::parse_int(kv(fields, "generation", "1"), 1)
    let n: lmanifest::NewOs = lmanifest::NewOs { name: kv(fields, "name", ""), version: kv(fields, "version", ""),
        base: kv(fields, "base", "fedora"), base_release: kv(fields, "base_release", "43"),
        arch: kv(fields, "arch", "x86_64"), channel: kv(fields, "channel", "rolling"),
        tag: kv(fields, "tag", ""), parent: kv(fields, "parent", ""), generation: gen,
        kind: kv(fields, "kind", "base"), created: kv(fields, "created", "") }
    let mut d: lmanifest::Doc = lmanifest::new_os_manifest(n)
    let mut i: int = 0
    while i < fields.len() is
        let p: [string] = text::split_once(fields[i], "=")
        if p.len() == 2 is
            let sk: [string] = text::split_once(p[0], ".")
            if sk.len() == 2 is d = lmanifest::put_str(d, sk[0], sk[1], p[1]) end
        end
        i += 1
    end
    let probs: [string] = lmanifest::validate_manifest(d)
    if probs.len() > 0 is return "manifest.toml: " + probs[0] end
    return lmanifest::save(path, d)
end

;; Rejestruje obraz bazowy w <root>/state/deployments (rekord wdrożenia z manifestu). "" albo błąd.
