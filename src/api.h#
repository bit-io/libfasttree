;; "" gdy plik istnieje i poprawnie się parsuje; inaczej opis błędu (z numerem linii).
pub fn hk_check(path: string) -> string is
    if !fs::exists(path) is return "brak pliku " + path end
    let r: hk::ParseResult = hk::parse(fs::read(path))
    if !r.ok is return path + ": " + r.error end
    return ""
end

fn hk_doc(path: string) -> hk::Doc is
    if !fs::exists(path) is return hk::empty() end
    let r: hk::ParseResult = hk::parse(fs::read(path))
    if !r.ok is return hk::empty() end
    return r.doc
end

