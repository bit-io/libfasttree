end

;; Wdrożenie warstwowe: baza + drzewo zmian → nowy tag (derive). `layers` = "nazwa|nevra|repo".
;; Wynik: błąd albo "".
pub fn stage_layered(root: string, base_tag: string, changes_dir: string, new_tag: string,
                     layer_specs: [string], now: string) -> string is
    let mut ls: [deployment::Layer] = []
    let mut i: int = 0
    while i < layer_specs.len() is
        let p: [string] = text::split(layer_specs[i], "|")
        if p.len() == 3 is ls.push(deployment::new_layer(p[0], p[1], p[2])) end
        i += 1
    end
    let st: deployment::StageResult = deployment::stage_layered(layout::at(root), base_tag, changes_dir, new_tag, ls, now)
    if !st.ok is return st.error end
    return ""
end

