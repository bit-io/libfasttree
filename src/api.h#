pub fn system_manifest_layers(root: string) -> int is
    let m: lmanifest::ParseResult = lmanifest::load(layout::at(root).manifest)
    if !m.ok is return 0 end
    return lmanifest::table_sections(m.doc, "layer").len()
end
;; Problemy walidacji manifestu ("manifest.toml: …" gdy nie da się wczytać).
pub fn system_manifest_check(root: string) -> [string] is
    let m: lmanifest::ParseResult = lmanifest::load(layout::at(root).manifest)
    if !m.ok is return [m.error] end
    return lmanifest::validate_manifest(m.doc)
end
pub fn pending_tag(root: string) -> string is return deployment::pending_tag(layout::at(root)) end
pub fn tool_count(root: string) -> int is return tools::list(layout::at(root)).len() end
pub fn lpm_journal_dir(root: string) -> string is return layout::lpm_journal(layout::at(root)) end
pub fn path_deployments(root: string) -> string is return layout::deployments_dir(layout::at(root)) end
