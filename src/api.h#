;; Nowa generacja profilu. Wynik: [błąd, generacja, konflikt1, konflikt2…].
pub fn profile_build(root: string, roots: [string], note: string) -> [string] is
    let r: pkgstore::ProfileResult = pkgstore::profile_build(layout::at(root), roots, note)
    if !r.ok is return [r.error, "0"] end
    let mut out: [string] = ["", text::istr(r.generation)]
    let mut i: int = 0
    while i < r.conflicts.len() is
        out.push(r.conflicts[i])
        i += 1
    end
    return out
end

