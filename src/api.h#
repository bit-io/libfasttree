;;  api — fasada biblioteki libfasttree dla kodu H# (lpm, lepm, builder).
;;
;;  Po co: `fasttree` jako program CLI nie może być wołany przez lpm ani builder
;;  (zasada projektu: libfasttree = BIBLIOTEKA, `use "bit -> libfasttree"`).
;;  CLI (`cli.h#`) jest cienką nakładką na te same funkcje.
;;
;;  Konwencje (celowo proste — omijają ograniczenie H# 0.9, zob. Z-SHARP-GAPS N2:
;;  struktury z typami z aliasu biblioteki przechodzą w C++ w `Any`):
;;    * WSZYSTKIE parametry i wyniki to typy proste: string, int, bool, [string];
;;    * funkcje zwracają napis błędu — "" oznacza sukces;
;;    * nic nie jest drukowane (wołający decyduje o interfejsie), nic nie czyta
;;      zmiennych środowiskowych — katalog repozytorium (`ft_root`) jest argumentem;
;;    * pliki .hk/.toml są identyfikowane ścieżką (parsowane przy każdym wywołaniu —
;;      pliki konfiguracyjne są małe).
;;
;;  Użycie (tylko w pliku wejściowym projektu — zob. docs/USING-AS-LIBRARY.md):
;;      use "bit -> libfasttree" from "ft"
;;      let err: string = ft::api::snapshot(ft_root, rootfs, tag)
;; ═══════════════════════════════════════════════════════════════════════════

pub fn version() -> string is return "0.8.0" end

fn tab() -> string is return __builtin_char_code_to_str(9) end

;; Tworzy podkatalogi repozytorium FastTree (store, manifests, deployments, layers-cache).
pub fn ensure_repo(ft_root: string) is
    sys::mkdir_p(text::path_join(ft_root, "store"))
    sys::mkdir_p(text::path_join(ft_root, "deployments"))
    sys::mkdir_p(text::path_join(ft_root, "manifests"))
    sys::mkdir_p(text::path_join(ft_root, "layers-cache"))
end

;; ── Obrazy: snapshot / pull / deploy / rollback ─────────────────────────────

;; Manifest + chunki CAS z lokalnego katalogu → manifests/<tag>.json. Zastępuje `fasttree snapshot`.
pub fn snapshot(ft_root: string, dir: string, tag: string) -> string is
    if !repo::valid_tag(tag) is return "niepoprawna nazwa taga: '" + tag + "'" end
    if !fs::is_dir(dir) is return "'" + dir + "' nie jest katalogiem" end
    ensure_repo(ft_root)
    let so: store::OpenResult = store::open(text::path_join(ft_root, "store"))
    if !so.ok is return so.error end
    let br: manifest::BuildResult = manifest::build_default(dir, so.store)
    if !br.ok is return br.error end
    let mpath: string = manifest::manifest_path_in(ft_root, tag)
    if !sys::write_text(mpath, manifest::to_json(br.manifest)) is return "nie można zapisać " + mpath end
    return ""
end

;; Liczba wpisów manifestu taga (-1 gdy brak/uszkodzony) — do raportów.
pub fn manifest_entries(ft_root: string, tag: string) -> int is
    let p: string = manifest::manifest_path_in(ft_root, tag)
    if !fs::exists(p) is return 0 - 1 end
    let pr: manifest::ParseResult = manifest::load(p)
    if !pr.ok is return 0 - 1 end
    return pr.manifest.entries.len()
end

;; Pobranie obrazu OCI do repozytorium (warstwy → scalenie → manifest). Zastępuje `fasttree pull`.
;; `alias` = "" → tag z referencji. Zwraca błąd albo "".
pub fn pull(ft_root: string, image_ref: string, alias: string) -> string is
    ensure_repo(ft_root)
    let so: store::OpenResult = store::open(text::path_join(ft_root, "store"))
    if !so.ok is return so.error end
    let rr: oci::RefResult = oci::parse_image_ref(image_ref)
    if !rr.ok is return rr.error end
    let mut tag: string = text::join(text::split(rr.ref.reference, ":"), "_")
    if alias != "" is
        if !repo::valid_tag(alias) is return "niepoprawna nazwa taga: '" + alias + "'" end
        tag = alias
    end
    let res: oci::ResolveResult = oci::resolve_image_layers(rr.ref, text::path_join(ft_root, "layers-cache"))
    if !res.ok is return res.error end
    let mut paths: [string] = []
    let mut i: int = 0
    while i < res.layers.len() is
        let rl: oci::ResolvedLayer = res.layers[i]
        paths.push(rl.path)
        i += 1
    end
    let work: string = text::path_join(text::path_join(sys::tmp_dir(), "fasttree-pull"), tag)
    sys::rm_rf(work)
    let merged: string = text::path_join(work, "merged")
    let lr: layers::LayerResult = layers::materialize_layers(paths, text::path_join(work, "layers"), merged)
    if !lr.ok is return lr.error end
    let br: manifest::BuildResult = manifest::build_default(merged, so.store)
    if !br.ok is return br.error end
    let mpath: string = manifest::manifest_path_in(ft_root, tag)
    if !sys::write_text(mpath, manifest::to_json(br.manifest)) is return "nie można zapisać " + mpath end
    sys::rm_rf(work)
    return ""
end

;; Obraz composefs (EROFS) + dm-verity + podmiana `current`. `atomic` = symlink pod
;; nazwą tymczasową + rename(2). Zastępuje `fasttree deploy <tag> --atomic`.
pub fn deploy(ft_root: string, tag: string, atomic: bool) -> string is
    ensure_repo(ft_root)
    let so: store::OpenResult = store::open(text::path_join(ft_root, "store"))
    if !so.ok is return so.error end
    let mpath: string = manifest::manifest_path_in(ft_root, tag)
    if !fs::exists(mpath) is return "brak manifestu dla '" + tag + "' (najpierw pull albo snapshot)" end
    let pr: manifest::ParseResult = manifest::load(mpath)
    if !pr.ok is return pr.error end
    let deploy_dir: string = text::path_join(text::path_join(ft_root, "deployments"), tag)
    let image: string = deploy_dir + ".erofs"
    let br: composefs::CfsResult = composefs::build_image(pr.manifest, so.store, deploy_dir + ".materialized", image)
    if !br.ok is return br.error end
    if !sys::write_text(image + ".digest", br.value) is return "nie można zapisać " + image + ".digest" end
    let v: composefs::DmVerityInfo = composefs::dm_verity_format(image)
    if !v.ok is return v.error end
    if !sys::write_text(image + ".veritysum", v.root_hash) is return "nie można zapisać " + image + ".veritysum" end
    let link: string = text::path_join(ft_root, "current")
    if atomic is
        let tmp: string = link + ".tmp"
        if sys::exists_any(tmp) is sys::rm_f(tmp) end
        if !sys::symlink(image, tmp) is return "nie można utworzyć symlinku " + tmp end
        fs::rename(tmp, link)
    else is
        if sys::exists_any(link) is sys::rm_f(link) end
        if !sys::symlink(image, link) is return "nie można utworzyć symlinku " + link end
    end
    ;; PREVIOUS_TAG musi być zapisany PRZED nadpisaniem CURRENT_TAG.
    let cur_f: string = text::path_join(ft_root, "CURRENT_TAG")
    if fs::exists(cur_f) is
        let prev: string = text::trim(fs::read(cur_f))
        if prev != tag is
            let w: bool = sys::write_text(text::path_join(ft_root, "PREVIOUS_TAG"), prev)
        end
    end
    if !sys::write_text(cur_f, tag) is return "nie można zapisać CURRENT_TAG" end
    return ""
end

