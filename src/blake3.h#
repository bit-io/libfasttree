fn first8(v: [int]) -> [int] is
    let mut o: [int] = []
    let mut i: int = 0
    while i < 8 is
        o.push(v[i])
        i += 1
    end
    return o
end

fn iv_cv() -> [int] is
    let mut o: [int] = []
    let mut i: int = 0
    while i < 8 is
        o.push(iv(i))
        i += 1
    end
    return o
end

;; Pełny 64-bajtowy blok -> 16 słów LE bez pętli wewnętrznych (generator: tools/gen_blake3.py).
fn words_full(data: [int], off: int) -> [int] is
    let mut w: [int] = []
    w.push((data[off + 0] & 255) | ((data[off + 1] & 255) << 8) | ((data[off + 2] & 255) << 16) | ((data[off + 3] & 255) << 24))
    w.push((data[off + 4] & 255) | ((data[off + 5] & 255) << 8) | ((data[off + 6] & 255) << 16) | ((data[off + 7] & 255) << 24))
    w.push((data[off + 8] & 255) | ((data[off + 9] & 255) << 8) | ((data[off + 10] & 255) << 16) | ((data[off + 11] & 255) << 24))
    w.push((data[off + 12] & 255) | ((data[off + 13] & 255) << 8) | ((data[off + 14] & 255) << 16) | ((data[off + 15] & 255) << 24))
    w.push((data[off + 16] & 255) | ((data[off + 17] & 255) << 8) | ((data[off + 18] & 255) << 16) | ((data[off + 19] & 255) << 24))
    w.push((data[off + 20] & 255) | ((data[off + 21] & 255) << 8) | ((data[off + 22] & 255) << 16) | ((data[off + 23] & 255) << 24))
    w.push((data[off + 24] & 255) | ((data[off + 25] & 255) << 8) | ((data[off + 26] & 255) << 16) | ((data[off + 27] & 255) << 24))
    w.push((data[off + 28] & 255) | ((data[off + 29] & 255) << 8) | ((data[off + 30] & 255) << 16) | ((data[off + 31] & 255) << 24))
    w.push((data[off + 32] & 255) | ((data[off + 33] & 255) << 8) | ((data[off + 34] & 255) << 16) | ((data[off + 35] & 255) << 24))
    w.push((data[off + 36] & 255) | ((data[off + 37] & 255) << 8) | ((data[off + 38] & 255) << 16) | ((data[off + 39] & 255) << 24))
