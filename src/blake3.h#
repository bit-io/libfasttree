;; bajty [off, off+len) -> 16 słów little-endian, dopełnione zerami.
fn words_of(data: [int], off: int, len: int) -> [int] is
    let mut w: [int] = []
    let mut i: int = 0
    while i < 16 is
        let base: int = i * 4
        let mut x: int = 0
        let mut k: int = 0
        while k < 4 is
            let p: int = base + k
            if p < len is
                let b: int = data[off + p] & 255
                let sh: int = k * 8
                let part: int = b << sh
                x = x | part
            end
            k += 1
        end
        w.push(x)
        i += 1
    end
    return w
end

;; "Wyjście" węzła: wszystko, czego trzeba do policzenia CV albo roota.
pub struct Out is
    pub cv:        [int]
    pub block:     [int]
    pub counter:   int
    pub block_len: int
    pub flags:     int
end

fn out_cv(o: Out) -> [int] is
    return first8(compress(o.cv, o.block, o.counter, o.block_len, o.flags))
end

;; Przetwarza jeden chunk (<= 1024 B) i zwraca jego `Out` (jeszcze bez
;; CHUNK_END policzonego do CV — ostatni blok zostaje do finalizacji).
fn chunk_out(data: [int], off: int, len: int, chunk_counter: int) -> Out is
    let mut cv: [int] = iv_cv()
    let mut nblocks: int = (len + 63) / 64
    if nblocks == 0 is nblocks = 1 end
    let mut b: int = 0
    while b < nblocks - 1 is
        let mut fl: int = 0
        if b == 0 is fl = 1 end
        let w: [int] = words_full(data, off + b * 64)
        cv = first8(compress(cv, w, chunk_counter, 64, fl))
        b += 1
    end
    let last_off: int = b * 64
    let last_len: int = len - last_off
    let mut fl2: int = 2
    if b == 0 is fl2 = 3 end
    let lw: [int] = words_of(data, off + last_off, last_len)
    return Out { cv: cv, block: lw, counter: chunk_counter, block_len: last_len, flags: fl2 }
end

fn parent_words(l: [int], r: [int]) -> [int] is
    let mut w: [int] = []
    let mut i: int = 0
    while i < 8 is
        w.push(l[i])
        i += 1
    end
    i = 0
    while i < 8 is
        w.push(r[i])
        i += 1
    end
    return w
end

fn parent_out(l: [int], r: [int]) -> Out is
    return Out { cv: iv_cv(), block: parent_words(l, r), counter: 0, block_len: 64, flags: 4 }
end

;; 32-bajtowy digest jako [int] 0..255.
fn root_bytes(o: Out) -> [int] is
    let st: [int] = compress(o.cv, o.block, 0, o.block_len, o.flags | 8)
    let mut out: [int] = []
    let mut i: int = 0
    while i < 8 is
        let w: int = st[i]
        let mut k: int = 0
        while k < 4 is
            let sh: int = k * 8
            let sv: int = w >> sh
            out.push(sv & 255)
            k += 1
        end
        i += 1
    end
    return out
end

;; Hash dowolnego bufora bajtów -> 32 bajty.
pub fn hash(data: [int]) -> [int] is
    let n: int = data.len()
    if n <= 1024 is
        return root_bytes(chunk_out(data, 0, n, 0))
    end
    let nchunks: int = (n + 1023) / 1024
    ;; stos CV-ów (lewe poddrzewa) z jawnym wskaźnikiem `sp` — `.pop()` na
    ;; tablicach nie ma kodowania w backendzie LLVM H# 0.9, więc nie używamy.
    let mut stack: [[int]] = []
    let mut sp: int = 0
    let mut ci: int = 0
    while ci < nchunks - 1 is
        let o: Out = chunk_out(data, ci * 1024, 1024, ci)
        let mut cv: [int] = out_cv(o)
        let mut total: int = ci + 1
        while (total & 1) == 0 is
            sp -= 1
            let left: [int] = stack[sp]
            cv = out_cv(parent_out(left, cv))
            total = total / 2
        end
        let slen: int = stack.len()
        if sp < slen is
            stack[sp] = cv
        else is
            stack.push(cv)
        end
        sp += 1
        ci += 1
    end
    let lastoff: int = (nchunks - 1) * 1024
    let mut cur: Out = chunk_out(data, lastoff, n - lastoff, nchunks - 1)
    let mut rem: int = sp
    while rem > 0 is
        rem -= 1
        cur = parent_out(stack[rem], out_cv(cur))
    end
    return root_bytes(cur)
end
