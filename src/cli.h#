;; Drukuje wpisy diff w formacie wspólnym dla `status --diff` i `diff`.
fn print_diff_entries(d: [manifest::DiffEntry]) is
    let dn: int = d.len()
    let mut i: int = 0
    while i < dn is
        let e: manifest::DiffEntry = d[i]
        i += 1
        let kind: string = e.kind
        let p: string = e.path
        if kind == "added" is
            say("  + " + p + "  (" + text::istr(e.new_chunks) + " chunków)")
        else if kind == "removed" is
            say("  - " + p + "  (" + text::istr(e.old_chunks) + " chunków)")
        else is
            say("  ~ " + p + "  (" + text::istr(e.old_chunks) + " -> " + text::istr(e.new_chunks) + " chunków, " + text::istr(e.reused_chunks) + " reużytych)")
        end
    end
end

;; Buduje manifest z lokalnego katalogu (bez rejestru OCI): chunki do CAS,
;; manifest do manifests/<tag>.json. Przydatne do testów i do własnych drzew.
pub fn cmd_snapshot(dir: string, tag: string) -> int is
    ensure_layout()
    if !repo::valid_tag(tag) is return fail("niepoprawna nazwa taga: '" + tag + "'") end
    if !fs::is_dir(dir) is return fail("'" + dir + "' nie jest katalogiem") end
    let root: string = root_dir()
    let so: store::OpenResult = store::open(text::path_join(root, "store"))
    if !so.ok is return fail(so.error) end
    let br: manifest::BuildResult = manifest::build_default(dir, so.store)
    if !br.ok is return fail(br.error) end
    let mpath: string = manifest::manifest_path_in(root, tag)
    if !fs::write(mpath, manifest::to_json(br.manifest)) is return fail("nie można zapisać " + mpath) end
    let n: int = br.manifest.entries.len()
    say("[fasttree] snapshot '" + tag + "': " + text::istr(n) + " wpisów, root=" + br.manifest.root)
    return 0
end

pub fn cmd_list() -> int is
    ensure_layout()
    let root: string = root_dir()
    let tags: [string] = repo::list_tags(root)
    let n: int = tags.len()
    if n == 0 is
        say("[fasttree] brak manifestów (użyj 'fasttree pull' lub 'fasttree snapshot')")
        return 0
    end
    let cur: string = repo::current_tag(root)
    let prev: string = repo::previous_tag(root)
    say("[fasttree] " + text::istr(n) + " tag(ów):")
    let mut i: int = 0
    while i < n is
        let t: string = tags[i]
        i += 1
        let mut marks: [string] = []
        if t == cur is marks.push("current") end
        if t == prev is marks.push("previous") end
        if repo::is_pinned(root, t) is marks.push("pinned") end
        let mn: int = marks.len()
        if mn == 0 is
            say("  " + t)
        else is
            say("  " + t + "  [" + text::join(marks, ", ") + "]")
        end
    end
    return 0
end

