fn str_array(xs: [string]) -> json::J is
    let mut arr: [json::J] = []
    let n: int = xs.len()
    let mut i: int = 0
    while i < n is
        arr.push(json::jstr(xs[i]))
        i += 1
    end
    return json::jarr(arr)
end

