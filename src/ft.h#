;; ═══════════════════════════════════════════════════════════════════════════
;;  Stabilne API C (ABI) biblioteki fasttree.
;;
;;  Kompilator H# eksportuje `pub fn` modułu `ft` jako symbole `ft_<nazwa>`
;;  (int -> int64_t, bool -> bool, string -> const char*). Ten moduł jest
;;  JEDYNĄ powierzchnią ABI — wszystko inne w bibliotece to wewnętrzne API
;;  H# (moduły store, manifest, ...), widoczne z kodu H# przez `mod`.
;;
;;  Konwencje (BEZSTANOWE — H# 0.9 nie ma mutowalnych globali, więc nie ma
;;  uchwytów ani `last_error`):
;;    * store/manifest są identyfikowane ścieżką (`root`), nie uchwytem;
;;    * funkcje zwracające wynik złożony zwracają napis JSON — kopertę
;;      {"ok":true,...} albo {"ok":false,"error":"..."};
;;    * dane binarne przekraczają granicę FFI jako hex (napisy C kończą się
;;      NUL-em) albo — lepiej, dla dużych danych — jako ścieżki plików;
;;    * zwrócone napisy należą do runtime'u H# — NIE wolno ich zwalniać
;;      (`free`); skopiuj je od razu (runtime H# 0.9 nie ma GC i trzyma je
;;      do końca procesu).
;; ═══════════════════════════════════════════════════════════════════════════

pub fn abi_version() -> int is return 1 end
;; Wersja addytywnych rozszerzeń ABI w ramach abi_version 1 (0.3: repo/fsck/stats, 0.4: repo_derive).
pub fn abi_minor() -> int is return 2 end
pub fn format_version() -> int is return 1 end
pub fn hash_algo() -> string is return hashing::algo_name() end

fn env_ok() -> json::J is
    let o: json::J = json::jobj()
    json::set(o, "ok", json::jbool(true))
    return o
end

fn fail(msg: string) -> string is
    let o: json::J = json::jobj()
    json::set(o, "ok", json::jbool(false))
    json::set(o, "error", json::jstr(msg))
    return json::to_json(o)
end

fn done(o: json::J) -> string is
    return json::to_json(o)
end

fn cfg_of(min_size: int, avg_size: int, max_size: int) -> chunker::ChunkerConfig is
    let d: chunker::ChunkerConfig = chunker::default_config()
    let mut mn: int = d.min_size
    let mut av: int = d.avg_size
    let mut mx: int = d.max_size
    if min_size > 0 is mn = min_size end
    if avg_size > 0 is av = avg_size end
    if max_size > 0 is mx = max_size end
    return chunker::ChunkerConfig { min_size: mn, avg_size: av, max_size: mx }
end

;; ── Hashe i chunker ─────────────────────────────────────────────────────────

;; Hash bajtów zakodowanych jako hex ("" przy niepoprawnym hexie).
pub fn hash_hex(data_hex: string) -> string is
    let n: int = data_hex.len()
    if n == 0 is return hashing::hash_bytes([]) end
    let raw: [int] = hashing::hex_decode(data_hex)
    let rn: int = raw.len()
    if rn == 0 is return "" end
    return hashing::hash_bytes(raw)
end

pub fn hash_file(path: string) -> string is
    if !fs::exists(path) is return "" end
    let b: bytes = fs::read_bytes(path)
    return hashing::hash_bytes(store::bytes_to_ints(b))
end

;; Granice chunków pliku (0 = domyślne): [{"offset":..,"size":..,"hash":".."}].
pub fn chunk_file(path: string, min_size: int, avg_size: int, max_size: int) -> string is
    if !fs::exists(path) is return fail("brak pliku: " + path) end
    let b: bytes = fs::read_bytes(path)
    let data: [int] = store::bytes_to_ints(b)
    let rs: [chunker::Range] = chunker::chunk_ranges(data, cfg_of(min_size, avg_size, max_size))
    let mut arr: [json::J] = []
    let n: int = rs.len()
    let mut i: int = 0
    while i < n is
        let r: chunker::Range = rs[i]
        i += 1
        let off: int = r.offset
        let stop: int = r.offset + r.size
        let part: [int] = data[off..stop]
        let o: json::J = json::jobj()
        json::set(o, "offset", json::jint(off))
        json::set(o, "size", json::jint(r.size))
        json::set(o, "hash", json::jstr(hashing::hash_bytes(part)))
        arr.push(o)
    end
    let env: json::J = env_ok()
    json::set(env, "chunks", json::jarr(arr))
    return done(env)
end

;; ── Store ───────────────────────────────────────────────────────────────────

pub fn store_put_file(root: string, path: string) -> string is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return fail(o.error) end
    if !fs::exists(path) is return fail("brak pliku: " + path) end
    let b: bytes = fs::read_bytes(path)
    let p: store::PutResult = store::put(o.store, store::bytes_to_ints(b))
    if !p.ok is return fail(p.error) end
    let env: json::J = env_ok()
    json::set(env, "hash", json::jstr(p.hash))
    return done(env)
end

pub fn store_put_hex(root: string, data_hex: string) -> string is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return fail(o.error) end
    let n: int = data_hex.len()
    let mut raw: [int] = []
    if n > 0 is
        raw = hashing::hex_decode(data_hex)
        let rn: int = raw.len()
        if rn == 0 is return fail("niepoprawny hex") end
    end
    let p: store::PutResult = store::put(o.store, raw)
    if !p.ok is return fail(p.error) end
    let env: json::J = env_ok()
    json::set(env, "hash", json::jstr(p.hash))
    return done(env)
end

;; Zapisuje obiekt do pliku `dest`; {"ok":true,"found":bool}.
pub fn store_get_file(root: string, hash: string, dest: string) -> string is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return fail(o.error) end
    if !hashing::is_valid_hash(hash) is return fail("niepoprawny hash: " + hash) end
    let found: bool = store::has(o.store, hash)
    let env: json::J = env_ok()
    json::set(env, "found", json::jbool(found))
    if found is
        let r: sys::Exec = sys::exec("cp -- " + sys::sq(store::object_path(o.store, hash)) + " " + sys::sq(dest))
        if r.code != 0 is return fail("kopiowanie obiektu nie powiodło się: " + r.out) end
    end
    return done(env)
end

;; Obiekt jako hex w polu "data" (dla małych obiektów).
pub fn store_get_hex(root: string, hash: string) -> string is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return fail(o.error) end
    let g: store::GetResult = store::get(o.store, hash)
    if !g.ok is return fail(g.error) end
    let env: json::J = env_ok()
    json::set(env, "found", json::jbool(g.found))
    if g.found is json::set(env, "data", json::jstr(hashing::hex_of(g.data))) end
    return done(env)
end

pub fn store_has(root: string, hash: string) -> bool is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return false end
    return store::has(o.store, hash)
end

;; `hashes_json` — tablica JSON napisów; zwraca {"ok":true,"missing":[...]}.
pub fn store_missing(root: string, hashes_json: string) -> string is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return fail(o.error) end
    let p: json::Parsed = json::parse(hashes_json)
    if !p.ok || p.value.kind != 4 is return fail("oczekiwano tablicy JSON z hashami") end
    let mut hs: [string] = []
    let n: int = p.value.items.len()
    let mut i: int = 0
    while i < n is
        hs.push(json::as_str(p.value.items[i], ""))
        i += 1
    end
    let miss: [string] = store::missing(o.store, hs)
    let mut arr: [json::J] = []
    for m in miss is
        arr.push(json::jstr(m))
    end
    let env: json::J = env_ok()
    json::set(env, "missing", json::jarr(arr))
    return done(env)
end

pub fn store_list(root: string) -> string is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return fail(o.error) end
    let all: [string] = store::list_all(o.store)
    let mut arr: [json::J] = []
    for h in all is
        arr.push(json::jstr(h))
    end
    let env: json::J = env_ok()
    json::set(env, "hashes", json::jarr(arr))
    return done(env)
end

pub fn store_delete(root: string, hash: string) -> bool is
    let o: store::OpenResult = store::open(root)
    if !o.ok is return false end
    return store::delete_object(o.store, hash)
end

