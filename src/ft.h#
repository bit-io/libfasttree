    if !o.ok is return fail(o.error) end
    let r: fsck::StoreFsck = fsck::check_store(o.store, repair)
    if !r.ok is return fail(r.error) end
    let env: json::J = env_ok()
    json::set(env, "scanned", json::jint(r.scanned))
    json::set(env, "totalBytes", json::jint(r.total_bytes))
