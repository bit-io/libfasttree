pub fn composefs_build(manifest_json: string, store_root: string, materialized_dir: string, output_image: string) -> string is
    let o: store::OpenResult = store::open(store_root)
    if !o.ok is return fail(o.error) end
    let p: manifest::ParseResult = manifest::from_json(manifest_json)
    if !p.ok is return fail(p.error) end
    let r: composefs::CfsResult = composefs::build_image(p.manifest, o.store, materialized_dir, output_image)
    if !r.ok is return fail(r.error) end
    let env: json::J = env_ok()
    json::set(env, "digest", json::jstr(r.value))
    return done(env)
end

pub fn composefs_mount(image: string, mountpoint: string, basedir: string) -> string is
    let r: composefs::CfsResult = composefs::mount_image(image, mountpoint, basedir)
    if !r.ok is return fail(r.error) end
    return done(env_ok())
end

pub fn composefs_mount_verified(image: string, mountpoint: string, expected_digest: string, basedir: string) -> string is
    let r: composefs::CfsResult = composefs::mount_verified(image, mountpoint, expected_digest, basedir)
    if !r.ok is return fail(r.error) end
    return done(env_ok())
end

pub fn fs_verity_kernel_support() -> bool is return composefs::fs_verity_kernel_support() end
pub fn device_mapper_available() -> bool is return composefs::device_mapper_available() end

pub fn dmverity_format(data_path: string) -> string is
    let r: composefs::DmVerityInfo = composefs::dm_verity_format(data_path)
    if !r.ok is return fail(r.error) end
    let env: json::J = env_ok()
    json::set(env, "rootHash", json::jstr(r.root_hash))
    json::set(env, "hashTreePath", json::jstr(r.hash_tree_path))
    return done(env)
end

pub fn dmverity_verify(data_path: string, hash_tree_path: string, root_hash: string) -> bool is
    return composefs::dm_verity_verify(data_path, hash_tree_path, root_hash)
end

pub fn dmverity_open(data_path: string, hash_tree_path: string, root_hash: string, mapper_name: string) -> string is
    let r: composefs::CfsResult = composefs::dm_verity_open(data_path, hash_tree_path, root_hash, mapper_name)
    if !r.ok is return fail(r.error) end
    let env: json::J = env_ok()
    json::set(env, "device", json::jstr(r.value))
    return done(env)
end

pub fn dmverity_close(mapper_name: string) is
    composefs::dm_verity_close(mapper_name)
end

;; ── OverlayFS ───────────────────────────────────────────────────────────────

pub fn overlay_create(lowerdir: string, ft_root: string, name: string, mountpoint: string, ephemeral: bool, size_mb: int) -> string is
    let mut r: overlay::OverlayResult = overlay::new_persistent_overlay(lowerdir, ft_root, name, mountpoint)
    if ephemeral is
        let mut mb: int = size_mb
        if mb <= 0 is mb = 512 end
        r = overlay::new_tmp_overlay(lowerdir, mountpoint, mb)
    end
    if !r.ok is return fail(r.error) end
    let env: json::J = env_ok()
    json::set(env, "mountpoint", json::jstr(r.overlay.mountpoint))
    json::set(env, "upperdir", json::jstr(r.overlay.upperdir))
    json::set(env, "workdir", json::jstr(r.overlay.workdir))
    json::set(env, "ephemeral", json::jbool(r.overlay.ephemeral))
    return done(env)
end

pub fn overlay_unmount(mountpoint: string, ephemeral: bool) -> string is
    let mut tmpfs: string = ""
    if ephemeral is tmpfs = mountpoint + ".tmpfs" end
    let ov: overlay::Overlay = overlay::Overlay { lowerdir: "", upperdir: "", workdir: "",
        mountpoint: mountpoint, ephemeral: ephemeral, tmpfs_mount: tmpfs }
    let e: string = overlay::unmount_overlay(ov)
    if e != "" is return fail(e) end
    return done(env_ok())
end

pub fn overlay_list(ft_root: string) -> string is
    let ovs: [overlay::OverlayInfo] = overlay::list_active_overlays(ft_root)
    let mut arr: [json::J] = []
    let n: int = ovs.len()
    let mut i: int = 0
    while i < n is
        let v: overlay::OverlayInfo = ovs[i]
        i += 1
        let o: json::J = json::jobj()
        json::set(o, "name", json::jstr(v.name))
        json::set(o, "mountpoint", json::jstr(v.mountpoint))
        json::set(o, "upperdir", json::jstr(v.upperdir))
        json::set(o, "ephemeral", json::jbool(v.ephemeral))
        json::set(o, "mounted", json::jbool(v.mounted))
        arr.push(o)
    end
    let env: json::J = env_ok()
    json::set(env, "overlays", json::jarr(arr))
    return done(env)
end

pub fn overlay_changes(upperdir: string) -> string is
    let ov: overlay::Overlay = overlay::Overlay { lowerdir: "", upperdir: upperdir, workdir: "",
        mountpoint: "", ephemeral: false, tmpfs_mount: "" }
    let ch: [string] = overlay::list_changes(ov)
    let mut arr: [json::J] = []
    for c in ch is
        arr.push(json::jstr(c))
    end
    let env: json::J = env_ok()
    json::set(env, "changes", json::jarr(arr))
    return done(env)
end

;; ── CLI ─────────────────────────────────────────────────────────────────────

;; Uruchamia komendę CLI; `args_json` = tablica JSON napisów (bez nazwy
;; programu). Zwraca kod wyjścia (0 = sukces); komunikaty idą na stdout/stderr.
pub fn cli_run(args_json: string) -> int is
    let p: json::Parsed = json::parse(args_json)
    if !p.ok || p.value.kind != 4 is return 2 end
    let mut args: [string] = []
    let n: int = p.value.items.len()
    let mut i: int = 0
    while i < n is
        args.push(json::as_str(p.value.items[i], ""))
        i += 1
    end
    return cli::run(args)
end
