;; `layers_json` — tablica JSON ścieżek do tarów warstw (dół -> góra).
pub fn layers_materialize(layers_json: string, work_dir: string, dest_dir: string) -> string is
    let p: json::Parsed = json::parse(layers_json)
    if !p.ok || p.value.kind != 4 is return fail("oczekiwano tablicy JSON ze ścieżkami warstw") end
    let mut paths: [string] = []
    let n: int = p.value.items.len()
    let mut i: int = 0
    while i < n is
        paths.push(json::as_str(p.value.items[i], ""))
        i += 1
    end
    let r: layers::LayerResult = layers::materialize_layers(paths, work_dir, dest_dir)
    if !r.ok is return fail(r.error) end
    return done(env_ok())
end

pub fn oci_parse_ref(image_ref: string) -> string is
    let r: oci::RefResult = oci::parse_image_ref(image_ref)
    if !r.ok is return fail(r.error) end
    let env: json::J = env_ok()
    json::set(env, "registry", json::jstr(r.ref.registry))
    json::set(env, "repository", json::jstr(r.ref.repository))
    json::set(env, "reference", json::jstr(r.ref.reference))
    return done(env)
end

pub fn oci_resolve_layers(image_ref: string, cache_dir: string) -> string is
    let r: oci::RefResult = oci::parse_image_ref(image_ref)
    if !r.ok is return fail(r.error) end
    let res: oci::ResolveResult = oci::resolve_image_layers(r.ref, cache_dir)
    if !res.ok is return fail(res.error) end
    let mut arr: [json::J] = []
    let n: int = res.layers.len()
    let mut i: int = 0
    while i < n is
        let l: oci::ResolvedLayer = res.layers[i]
        i += 1
        let o: json::J = json::jobj()
        json::set(o, "digest", json::jstr(l.layer.digest))
        json::set(o, "mediaType", json::jstr(l.layer.media_type))
        json::set(o, "size", json::jint(l.layer.size))
        json::set(o, "path", json::jstr(l.path))
        json::set(o, "cached", json::jbool(l.was_cached))
        arr.push(o)
    end
    let env: json::J = env_ok()
    json::set(env, "layers", json::jarr(arr))
    return done(env)
end

