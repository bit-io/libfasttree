;; Buduje manifest katalogu (chunki lądują w store pod `store_root`).
;; {"ok":true,"manifest":{...}}; 0 w rozmiarach = domyślne.
pub fn manifest_build(source_dir: string, store_root: string, min_size: int, avg_size: int, max_size: int) -> string is
    let o: store::OpenResult = store::open(store_root)
    if !o.ok is return fail(o.error) end
    let b: manifest::BuildResult = manifest::build(source_dir, o.store, cfg_of(min_size, avg_size, max_size))
    if !b.ok is return fail(b.error) end
    let env: json::J = env_ok()
    json::set(env, "manifest", manifest::to_json_value(b.manifest))
    return done(env)
end

;; Sprawdza poprawność manifestu i przeliczenie `root`.
pub fn manifest_verify(manifest_json: string) -> string is
    let p: manifest::ParseResult = manifest::from_json(manifest_json)
    if !p.ok is return fail(p.error) end
    let recomputed: string = manifest::compute_root(p.manifest.entries)
    let env: json::J = env_ok()
    json::set(env, "valid", json::jbool(recomputed == p.manifest.root))
    json::set(env, "root", json::jstr(p.manifest.root))
    json::set(env, "recomputedRoot", json::jstr(recomputed))
    json::set(env, "warning", json::jstr(p.warning))
    return done(env)
end

pub fn manifest_diff(old_json: string, new_json: string) -> string is
    let a: manifest::ParseResult = manifest::from_json(old_json)
    if !a.ok is return fail("stary manifest: " + a.error) end
    let b: manifest::ParseResult = manifest::from_json(new_json)
    if !b.ok is return fail("nowy manifest: " + b.error) end
    let d: [manifest::DiffEntry] = manifest::diff(a.manifest, b.manifest)
    let mut arr: [json::J] = []
    let n: int = d.len()
    let mut i: int = 0
    while i < n is
        let e: manifest::DiffEntry = d[i]
        i += 1
        let o: json::J = json::jobj()
        json::set(o, "kind", json::jstr(e.kind))
        json::set(o, "path", json::jstr(e.path))
        json::set(o, "oldChunks", json::jint(e.old_chunks))
        json::set(o, "newChunks", json::jint(e.new_chunks))
        json::set(o, "reusedChunks", json::jint(e.reused_chunks))
        arr.push(o)
    end
    let env: json::J = env_ok()
    json::set(env, "entries", json::jarr(arr))
    return done(env)
end

;; Odtwarza drzewo plików manifestu z chunków store'a do `dest_dir`.
pub fn manifest_materialize(manifest_json: string, store_root: string, dest_dir: string) -> string is
    let o: store::OpenResult = store::open(store_root)
    if !o.ok is return fail(o.error) end
    let p: manifest::ParseResult = manifest::from_json(manifest_json)
    if !p.ok is return fail(p.error) end
    let r: composefs::CfsResult = composefs::materialize_tree(p.manifest, o.store, dest_dir)
    if !r.ok is return fail(r.error) end
    return done(env_ok())
end

