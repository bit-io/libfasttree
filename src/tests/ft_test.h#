;; Testy rozszerzeń ABI 0.3 na poziomie H# (kształt i treść JSON). Warstwa
;; symboli C (`ft_*`) wymaga backendu LLVM i jest sprawdzana osobno.

fn setup(name: string) -> string is
    let root: string = text::path_join(sys::tmp_dir(), "fasttree-h-ft-" + name + "-" + text::istr(sys::pid()))
    sys::rm_rf(root)
    fs::mkdir(text::path_join(root, "manifests"))
    fs::mkdir(text::path_join(root, "deployments"))
    return root
end

fn add_tag(root: string, tag: string, content: string) -> manifest::Manifest is
    let o: store::OpenResult = store::open(text::path_join(root, "store"))
    let src: string = root + "-src-" + tag
    sys::rm_rf(src)
    fs::mkdir(src)
    let w: bool = fs::write(text::path_join(src, "f"), content)
    let b: manifest::BuildResult = manifest::build_default(src, o.store)
    let w2: bool = fs::write(manifest::manifest_path_in(root, tag), manifest::to_json(b.manifest))
    sys::rm_rf(src)
    return b.manifest
end

fn parse(s: string) -> json::J is
    let p: json::Parsed = json::parse(s)
    test::assert_true(p.ok)
    return p.value
end

fn is_ok(j: json::J) -> bool is
    let v: json::J = json::get(j, "ok")
    return v.kind == 1 && v.n == 1
end

fn flag(j: json::J, key: string) -> bool is
    let v: json::J = json::get(j, key)
    return v.kind == 1 && v.n == 1
end

#[test]
fn abi_versions() is
    check::eq(text::istr(ft::abi_version()), "1")
    check::eq(text::istr(ft::abi_minor()), "2")
end

#[test]
fn repo_tags_envelope() is
    let root: string = setup("tags")
    let m: manifest::Manifest = add_tag(root, "v2", "b")
    let m2: manifest::Manifest = add_tag(root, "v1", "a")
    let w: bool = fs::write(text::path_join(root, "CURRENT_TAG"), "v2")
    let j: json::J = parse(ft::repo_tags(root))
    test::assert_true(is_ok(j))
    let tags: json::J = json::get(j, "tags")
    check::eq(text::istr(tags.items.len()), "2")
    check::eq(json::as_str(tags.items[0], ""), "v1")
    check::eq(json::as_str(tags.items[1], ""), "v2")
    check::eq(json::as_str(json::get(j, "current"), "?"), "v2")
    check::eq(json::as_str(json::get(j, "previous"), "?"), "")
    sys::rm_rf(root)
end

#[test]
fn repo_pins_unpin_roundtrip() is
    let root: string = setup("pins")
    let w: bool = fs::write(text::path_join(root, "pins.json"), "[{\"tag\": \"v1\", \"note\": \"n1\", \"pinnedAt\": \"t\"}]")
    let j: json::J = parse(ft::repo_pins(root))
    test::assert_true(is_ok(j))
    let pins: json::J = json::get(j, "pins")
    check::eq(text::istr(pins.items.len()), "1")
    check::eq(json::as_str(json::get(pins.items[0], "note"), ""), "n1")
    let u: json::J = parse(ft::repo_unpin(root, "v1"))
    test::assert_true(is_ok(u))
    check::eq(text::istr(json::as_int(json::get(u, "removed"), -1)), "1")
    let u2: json::J = parse(ft::repo_unpin(root, "v1"))
    check::eq(text::istr(json::as_int(json::get(u2, "removed"), -1)), "0")
    sys::rm_rf(root)
end

#[test]
fn repo_errors_use_failure_envelope() is
    let root: string = setup("err")
    let r: json::J = parse(ft::repo_rollback(root))
    test::assert_false(is_ok(r))
    test::assert_true(text::contains(json::as_str(json::get(r, "error"), ""), "CURRENT_TAG"))
    let d: json::J = parse(ft::repo_remove_tag(root, "../zly"))
    test::assert_false(is_ok(d))
