    let sroot: string = text::path_join(root, "store")
    let a: json::J = parse(ft::stats_manifest(manifest::to_json(m), sroot))
    test::assert_true(is_ok(a))
    check::eq(text::istr(json::as_int(json::get(a, "files"), -1)), "1")
    check::eq(text::istr(json::as_int(json::get(a, "logicalBytes"), -1)), "12")
    check::eq(text::istr(json::as_int(json::get(a, "uniqueChunks"), -1)), "1")
    check::eq(text::istr(json::as_int(json::get(a, "dedupRatioX100"), -1)), "100")
    let b: json::J = parse(ft::stats_repo(root))
    test::assert_true(is_ok(b))
    check::eq(text::istr(json::as_int(json::get(b, "tags"), -1)), "1")
    check::eq(text::istr(json::as_int(json::get(b, "storeObjects"), -1)), "1")
    check::eq(text::istr(json::as_int(json::get(b, "orphanObjects"), -1)), "0")
    sys::rm_rf(root)
end

