end

#[test]
fn repo_rollback_and_remove() is
    let root: string = setup("rb")
    let m: manifest::Manifest = add_tag(root, "v1", "a")
    let m2: manifest::Manifest = add_tag(root, "v2", "b")
    let w: bool = fs::write(text::path_join(root, "deployments/v1.erofs"), "i1")
    let w2: bool = fs::write(text::path_join(root, "deployments/v2.erofs"), "i2")
    let w3: bool = fs::write(text::path_join(root, "CURRENT_TAG"), "v2")
    let w4: bool = fs::write(text::path_join(root, "PREVIOUS_TAG"), "v1")
    let r: json::J = parse(ft::repo_rollback(root))
    test::assert_true(is_ok(r))
    check::eq(json::as_str(json::get(r, "tag"), ""), "v1")
    let blocked: json::J = parse(ft::repo_remove_tag(root, "v1"))
    test::assert_false(is_ok(blocked))
    let ok: json::J = parse(ft::repo_remove_tag(root, "v2"))
    test::assert_true(is_ok(ok))
    test::assert_false(fs::exists(manifest::manifest_path_in(root, "v2")))
    sys::rm_rf(root)
end

#[test]
fn repo_derive_envelope() is
    let root: string = setup("dv")
    let m: manifest::Manifest = add_tag(root, "base", "baza")
    let ch: string = root + "-changes"
    fs::mkdir(ch)
    let w: bool = fs::write(ch + "/extra", "extra")
    let j: json::J = parse(ft::repo_derive(root, "base", ch, "plus"))
    test::assert_true(is_ok(j))
    check::eq(text::istr(json::as_int(json::get(j, "changed"), -1)), "1")
    check::eq(text::istr(json::as_int(json::get(j, "entries"), -1)), "2")
    test::assert_true(fs::exists(manifest::manifest_path_in(root, "plus")))
    let again: json::J = parse(ft::repo_derive(root, "base", ch, "plus"))
    test::assert_false(is_ok(again))
    sys::rm_rf(root)
    sys::rm_rf(ch)
end

#[test]
fn fsck_store_envelope() is
    let root: string = setup("fs")
    let m: manifest::Manifest = add_tag(root, "v1", "tresc")
    let sroot: string = text::path_join(root, "store")
    let clean: json::J = parse(ft::fsck_store(sroot, false))
    test::assert_true(is_ok(clean))
    check::eq(text::istr(json::as_int(json::get(clean, "scanned"), -1)), "1")
    check::eq(text::istr(json::get(clean, "corrupt").items.len()), "0")
    let o: store::OpenResult = store::open(sroot)
    let h: string = m.entries[0].chunks[0]
    let w: bool = fs::write(store::object_path(o.store, h), "inna!")
    let bad: json::J = parse(ft::fsck_store(sroot, true))
    check::eq(text::istr(json::get(bad, "corrupt").items.len()), "1")
    check::eq(json::as_str(json::get(bad, "corrupt").items[0], ""), h)
    check::eq(text::istr(json::as_int(json::get(bad, "repaired"), -1)), "1")
    sys::rm_rf(root)
end

#[test]
fn fsck_manifest_envelope() is
    let root: string = setup("fm")
    let m: manifest::Manifest = add_tag(root, "v1", "tresc")
    let sroot: string = text::path_join(root, "store")
    let txt: string = manifest::to_json(m)
    let j: json::J = parse(ft::fsck_manifest(txt, sroot))
    test::assert_true(is_ok(j))
    test::assert_true(flag(j, "clean"))
    test::assert_true(flag(j, "rootOk"))
    check::eq(json::as_str(json::get(j, "recomputedRoot"), ""), m.root)
    let o: store::OpenResult = store::open(sroot)
    let d: bool = store::delete_object(o.store, m.entries[0].chunks[0])
    let j2: json::J = parse(ft::fsck_manifest(txt, sroot))
    test::assert_false(flag(j2, "clean"))
    check::eq(text::istr(json::get(j2, "missing").items.len()), "1")
    let j3: json::J = parse(ft::fsck_manifest("nie json", sroot))
    test::assert_false(is_ok(j3))
    sys::rm_rf(root)
end

#[test]
fn fsck_repo_envelope() is
    let root: string = setup("fr")
    let m: manifest::Manifest = add_tag(root, "v1", "tresc")
    let ok: json::J = parse(ft::fsck_repo(root, false))
    test::assert_true(is_ok(ok))
    test::assert_true(flag(ok, "healthy"))
    check::eq(text::istr(json::as_int(json::get(ok, "tags"), -1)), "1")
    let w: bool = fs::write(text::path_join(root, "CURRENT_TAG"), "brak")
    let bad: json::J = parse(ft::fsck_repo(root, false))
    test::assert_true(is_ok(bad))
    test::assert_false(flag(bad, "healthy"))
    check::eq(text::istr(json::get(bad, "problems").items.len()), "1")
    sys::rm_rf(root)
end

#[test]
fn stats_envelopes() is
    let root: string = setup("st")
